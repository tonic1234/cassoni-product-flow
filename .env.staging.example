# Cassoni pipeline — plantilla de entorno STAGING (copiar a .env.staging local)
# NO commitear. Las credenciales reales viven en /root/cassoni-agent/creds/ (CASE).

# --- WooCommerce (STAGING) ---
CASSONI_WC_BASE=https://22f34d534b.nxcli.io
CASSONI_WC_KEY=
CASSONI_WC_SECRET=

# --- GSC (solo lectura) ---
CASSONI_GSC_SERVICE_ACCOUNT_FILE=/root/cassoni-agent/creds/gsc-service-account.json
CASSONI_GSC_SITE=sc-domain:cassoni.com

# --- DataForSEO ---
CASSONI_DFS_LOGIN=
CASSONI_DFS_PASSWORD=
CASSONI_DFS_MAX_REQ_MIN=12

# --- LLM (OpenAI-compatible: Gemini Flash / DeepSeek / Claude) ---
CASSONI_LLM_BASE_URL=
CASSONI_LLM_API_KEY=
CASSONI_LLM_EDITOR_MODEL=gemini-2.5-flash
CASSONI_LLM_VALIDATOR_MODEL=claude-3-5-sonnet

# --- DB ---
# SQLite (dev/test) o PostgreSQL (prod). Ej PG:
# CASSONI_DB_URL=postgresql://user:pass@host:5432/cassoni
CASSONI_DB_URL=sqlite:///./cassoni.db